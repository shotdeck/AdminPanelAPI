<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Raise upload limit to the IIS maximum (~4 GB) for movie files.
             maxAllowedContentLength is a uint32, so 4294967295 is the ceiling.
             Default IIS limit is ~28.6 MB. -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
